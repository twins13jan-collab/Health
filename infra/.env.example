# Copy to .env next to infra/docker-compose.yml and fill in real secrets.
# NEVER commit a filled .env. There is no .gitignore in this repo yet —
# add ".env" to it before any git push from a worktree.
#
# EC2 public address (IP or domain) that browsers will reach the API on.
# Baked into the web image at build time — changing it needs a rebuild.
NEXT_PUBLIC_API_BASE_URL=http://<EC2_PUBLIC_IP_OR_DOMAIN>:8080

# PostgreSQL superuser password (db service).
DB_PASSWORD=<strong-password>

# Keycloak bootstrap admin password.
KEYCLOAK_PASSWORD=<strong-password>

# !!! TRAP — read before changing !!!
# Flyway V1__core.sql creates the application role with a HARDCODED password:
#   CREATE ROLE app_user LOGIN PASSWORD 'change-me' NOBYPASSRLS;
# platform-api logs in as app_user with APP_DB_PASSWORD.
# So APP_DB_PASSWORD MUST stay 'change-me' until a later migration changes
# the role password. Setting it to anything else breaks the API login.
# (Default below is intentionally 'change-me'; do not "fix" it here.)
APP_DB_PASSWORD=change-me
